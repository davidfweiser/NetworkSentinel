# Network Sentinel web UI (systemd)
# Installed as /etc/networksentinel/web.env (system) or
# ~/.config/networksentinel/web.env (user install).

# Preferred high port (default 18765). Change if something else binds it.
WEB_PORT=18765

# HTTPS and DuckDNS are not set here — they persist in settings.json, so the
# service picks them up from Settings → Remote access (GUI or web console) or
# from `networksentinel --set-duckdns`. Any certificate for a name you own works;
# issue-duckdns-cert.sh is only for a free one on a duckdns.org name.
# A TLS port below 1024 needs root or AmbientCapabilities=CAP_NET_BIND_SERVICE
# in the unit; the default 18443 does not.

# The unit caps .NET's young-generation heap budget at 26 MB (0x1A00000), which
# keeps the console near 130 MB resident on a VPS whose large CPU cache would
# otherwise let it reach ~230 MB. A value here overrides the unit's (hex bytes).
#DOTNET_GCgen0size=0x1A00000
