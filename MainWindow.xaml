<Window x:Class="NetworkSentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:NetworkSentinel.Controls"
        xmlns:vm="clr-namespace:NetworkSentinel.ViewModels"
        Title="{Binding WindowTitle}"
        Height="860" Width="1320"
        MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.85" To="0.15" Duration="0:0:1.4"
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.55" Duration="0:0:1.4"
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.55" Duration="0:0:1.4"
                             AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Ambient background glows -->
        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-160,-180,0,0" Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#554C8DFF" Offset="0"/>
                    <GradientStop Color="#00070B16" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-140,-160" Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#553DE7C8" Offset="0"/>
                    <GradientStop Color="#00070B16" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-80,0" Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#669B7BFF" Offset="0"/>
                    <GradientStop Color="#00070B16" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="200" MaxWidth="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,4,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="42" Height="42" Margin="0,0,12,0">
                                <Ellipse Fill="{StaticResource AccentGradient}"/>
                                <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Wraps rather than clipping: the rail is 230px and the mark takes
                                     54 of them, which leaves the title a few pixels short of fitting
                                     on one line — it read as "Network Sentine". -->
                                <TextBlock Text="Network Sentinel" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Port &amp; intrusion watch" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" Opacity="0.85"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Background="#180C1A2E" CornerRadius="14" Padding="12" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Stats.StatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stats.IsMonitoring}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Paused"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stats.IsMonitoring}" Value="True">
                                                        <Setter Property="Text" Value="Live monitoring"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="10"
                                        BorderThickness="1" BorderBrush="{StaticResource StrokeSoftBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#180C1A2E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="True">
                                                    <Setter Property="Background" Value="#33FF4D6D"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="AUTO-BLOCK" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OFF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="True">
                                                                <Setter Property="Text" Value="ON"/>
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <CheckBox Content="Enable auto-block"
                                                  IsChecked="{Binding AutoBlockEnabled}"
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,8"/>

                        <RadioButton Content="Dashboard" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowDashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                        <RadioButton Content="Live Connections" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowConnections, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Connections"/>
                        <RadioButton Content="Remote Computers" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowHosts, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Hosts"/>
                        <RadioButton Content="Break-in Attempts" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowThreats, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Threats"/>
                        <RadioButton Content="Open Ports" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowPorts, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Ports"/>
                        <RadioButton Content="Firewall &amp; Block" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowFirewall, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Firewall"/>
                        <RadioButton Content="Firewall Config" Style="{StaticResource SubNavButton}"
                                     IsChecked="{Binding ShowFirewallConfig, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="FirewallConfig"
                                     ToolTip="Add, edit and delete inbound and outbound rules"/>
                        <RadioButton Content="Settings" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ShowSettings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar: title full-width, toolbar wraps so labels never cover the title -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding ClockText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text="Network Defense Console" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HeroSubtitle}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12"/>

                    <WrapPanel Orientation="Horizontal" ItemHeight="40">
                        <TextBox Width="180" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by IP, host, process, location…"
                                 Margin="0,0,8,8" VerticalAlignment="Center"/>
                        <Button Content="{Binding Stats.IsMonitoring, Converter={StaticResource MonitorText}}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ToggleMonitoringCommand}"
                                Margin="0,0,8,8" MinWidth="110" Padding="12,8"/>
                        <Button Command="{Binding ToggleAutoBlockCommand}"
                                Margin="0,0,8,8" MinWidth="110" Padding="12,8"
                                ToolTip="{Binding AutoBlockStatusText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Content" Value="Auto-block: Off"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="True">
                                            <Setter Property="Content" Value="Auto-block: On"/>
                                            <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Run as Admin" Style="{StaticResource GhostButton}"
                                Command="{Binding RunAsAdminCommand}"
                                ToolTip="{Binding FirewallStatusText}"
                                Margin="0,0,8,8" Padding="12,8"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <Button Content="Clear Alerts" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearThreatsCommand}" Margin="0,0,8,8" Padding="12,8"/>
                        <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshNowCommand}" Margin="0,0,8,8" Padding="12,8"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Pages -->
                <Grid Grid.Row="1">

                    <!-- DASHBOARD -->
                    <!-- Scrolled: the stat row, two chart rows and the two lists together are
                         taller than the window at its minimum height. -->
                    <ScrollViewer Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 250, not 220: the chart cards carry a legend row under the plot. -->
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="230"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Stats: wrap on narrow widths so labels aren't clipped -->
                        <UniformGrid Rows="1" Columns="5" Margin="0,0,0,14">
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0" MinWidth="0">
                                <StackPanel>
                                    <TextBlock Text="LISTENING PORTS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="LISTENING PORTS"/>
                                    <TextBlock Text="{Binding Stats.ListeningPorts}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock Text="TCP + UDP open" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0" MinWidth="0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE SESSIONS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="ACTIVE SESSIONS"/>
                                    <TextBlock Text="{Binding Stats.ActiveConnections}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentBlueBrush}"/>
                                    <TextBlock Text="TCP connections" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0" MinWidth="0">
                                <StackPanel>
                                    <TextBlock Text="REMOTE COMPUTERS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="REMOTE COMPUTERS"/>
                                    <TextBlock Text="{Binding Stats.RemoteHosts}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentIceBrush}"/>
                                    <TextBlock Text="Peers tracked" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0" MinWidth="0">
                                <StackPanel>
                                    <TextBlock Text="THREAT EVENTS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="THREAT EVENTS"/>
                                    <TextBlock Text="{Binding Stats.ThreatsToday}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentAmberBrush}"/>
                                    <TextBlock Text="Heuristic alerts" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" MinWidth="0">
                                <StackPanel>
                                    <TextBlock Text="HIGH / CRITICAL" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="HIGH / CRITICAL"/>
                                    <TextBlock Text="{Binding Stats.HighThreats}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="Needs attention" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Charts + pulse -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="Connection activity" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ActivityWindowText}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ctrl:Sparkline Grid.Row="1" Margin="0,12,0,0"
                                                    Values="{Binding ActivitySeries}"
                                                    Threats="{Binding ThreatSeries}"
                                                    Stroke="{StaticResource AccentCyanBrush}"
                                                    Fill="{StaticResource ChartFill}"
                                                    StrokeThickness="2.4"/>

                                    <!-- Legend row, matching the web chart: time range at the edges,
                                         current/peak connections and the window's alert count between. -->
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ActivityFromText}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="&#x25CF;" FontSize="11" Margin="0,0,4,0"
                                                       Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActivityConnectionsText}" FontSize="10" Margin="0,0,12,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#x25AE;" FontSize="11" Margin="0,0,4,0"
                                                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActivityThreatText}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ActivityToText}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource HeroGradient}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <Ellipse x:Name="PulseRing" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="2" Opacity="0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="PulseScale" CenterX="55" CenterY="55"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse Width="72" Height="72" Fill="#2218FFC8" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="2"/>
                                            <TextBlock Text="LIVE" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Grid>
                                        <TextBlock Text="Threat intensity" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Stats.HighThreats}" FontSize="28" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="high-severity signals" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- DATA FLOW — live throughput beside the running month's totals. -->
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="Data flow" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TrafficWindowText}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ctrl:DualSparkline Grid.Row="1" Margin="0,12,0,0"
                                                        Inbound="{Binding TrafficInSeries}"
                                                        Outbound="{Binding TrafficOutSeries}"
                                                        InboundStroke="{StaticResource AccentBlueBrush}"
                                                        OutboundStroke="{StaticResource AccentCyanBrush}"
                                                        InboundFill="{StaticResource ChartFill}"
                                                        StrokeThickness="2.2"/>

                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="&#x25CF;" FontSize="11" Margin="0,0,4,0"
                                                       Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TrafficInRateText}" FontSize="10" Margin="0,0,12,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#x25CF;" FontSize="11" Margin="0,0,4,0"
                                                       Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TrafficOutRateText}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TrafficStatusText}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THIS MONTH" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding MonthLabelText}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,8"/>
                                    <TextBlock Text="Data in" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding MonthInText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}"/>
                                    <TextBlock Text="Data out" FontSize="10" Margin="0,6,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding MonthOutText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock Text="{Binding MonthTotalText, StringFormat='{}{0} total'}" FontSize="11"
                                               Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MonthDailyAverageText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- MONTHLY DATA — one bar pair per day of the month, or per month of
                             the year. Bars, not a line: these are totals over discrete periods. -->
                        <Border Style="{StaticResource Card}" Grid.Row="3" Height="250" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Monthly data in and out" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding TrafficRangeSummary}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180" VerticalAlignment="Top"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding TrafficRangeOptions}"
                                              SelectedItem="{Binding SelectedTrafficRange}"/>
                                </Grid>
                                <ctrl:BarPairChart Grid.Row="1" Margin="0,12,0,0"
                                                   Buckets="{Binding TrafficBuckets}"
                                                   InboundBrush="{StaticResource AccentBlueBrush}"
                                                   OutboundBrush="{StaticResource AccentCyanBrush}"/>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="&#x25AE;" FontSize="11" Margin="0,0,4,0"
                                               Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="data in" FontSize="10" Margin="0,0,14,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#x25AE;" FontSize="11" Margin="0,0,4,0"
                                               Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="data out" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Bottom split: recent threats + top hosts -->
                        <Grid Grid.Row="4" Height="320">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Latest break-in signals" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Where · method · severity"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding Threats}" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#180C1628" CornerRadius="12" Padding="12"
                                                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border CornerRadius="3" Background="{Binding Level, Converter={StaticResource ThreatBrush}}"/>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                                           Margin="8,0,0,0" VerticalAlignment="Top"/>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding SourceIp}" Foreground="{StaticResource AccentCyanBrush}"
                                                                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Origin}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Method}" Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                            <!-- Same verdict the Threats table and the toast carry. -->
                                                            <TextBlock Text="{Binding BlockStatusDetail}" FontSize="11" FontWeight="SemiBold"
                                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding BlockStatusDetail, Converter={StaticResource NotEmptyVis}}"
                                                                       Foreground="{Binding BlockStatus, Converter={StaticResource BlockStatusBrush}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Connected / observed computers" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <ListBox ItemsSource="{Binding RemoteHosts}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#180C1628" CornerRadius="12" Padding="12"
                                                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding GeoSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap">
                                                                <Run Text="Ports hit:"/>
                                                                <Run Text="{Binding PortsTouched, Mode=OneWay}"/>
                                                                <Run Text=" · Active:"/>
                                                                <Run Text="{Binding ActiveConnections, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Top"
                                                                Background="#22000000">
                                                            <TextBlock Text="{Binding ThreatText}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding ThreatLevel, Converter={StaticResource ThreatBrush}}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>

                    <!-- CONNECTIONS -->
                    <Border Visibility="{Binding ShowConnections, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Live TCP connections" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Select a row and use Block to create a Windows Firewall rule for that remote IP."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Connections}" Style="{StaticResource ModernDataGrid}"
                                      SelectedItem="{Binding SelectedConnection}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Process" Binding="{Binding ProcessName}" Width="110"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Local" Binding="{Binding DisplayLocal}" Width="140"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Remote" Binding="{Binding DisplayRemote}" Width="*"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="State" Binding="{Binding StateText}" Width="90"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Origin" Binding="{Binding GeoSummary}" Width="170"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                                    <DataGridTemplateColumn Header="Action" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Block IP" Style="{StaticResource MiniDangerButton}"
                                                        Command="{Binding DataContext.BlockConnectionIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- HOSTS -->
                    <Border Visibility="{Binding ShowHosts, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Remote computers connected or probing this PC" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Block writes Windows Firewall rules for that IP. Private/LAN addresses are refused for safety."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding RemoteHosts}" Style="{StaticResource ModernDataGrid}"
                                      SelectedItem="{Binding SelectedHost}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="IP Address" Binding="{Binding IpAddress}" Width="120"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Host name" Binding="{Binding HostName}" Width="140"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Where (origin)" Binding="{Binding GeoSummary}" Width="*"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Threat" Binding="{Binding ThreatText}" Width="80"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Firewall" Binding="{Binding BlockStatusText}" Width="80"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Status" Binding="{Binding Status}" Width="90"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Active" Binding="{Binding ActiveConnections}" Width="60"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Ports" Binding="{Binding PortsTouched}" Width="60"/>
                                    <DataGridTemplateColumn Header="Actions" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Block" Style="{StaticResource MiniDangerButton}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.BlockHostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                    <Button Content="Unblock" Style="{StaticResource MiniGhostButton}"
                                                            Command="{Binding DataContext.UnblockHostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- THREATS -->
                    <Border Visibility="{Binding ShowThreats, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Break-in / intrusion attempt signals" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Heuristics detect port scans, RDP/SSH/SMB hammering, sensitive-port probes, and short-lived bursts. Block the source IP in Windows Firewall when needed."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Threats}" Style="{StaticResource ModernDataGrid}"
                                      SelectedItem="{Binding SelectedThreat}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Time" Binding="{Binding TimeText}" Width="70"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Severity" Binding="{Binding LevelText}" Width="80"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Type" Binding="{Binding TypeText}" Width="130"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Source IP" Binding="{Binding SourceIp}" Width="120"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Coming from" Binding="{Binding Origin}" Width="160"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Method" Binding="{Binding Method}" Width="150"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Detail" Binding="{Binding Detail}" Width="*"/>
                                    <!-- Whether the source address is being blocked; hover for the reason. -->
                                    <DataGridTemplateColumn Header="Blocked" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BlockStatus}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding BlockStatus, Converter={StaticResource BlockStatusBrush}}"
                                                           ToolTip="{Binding BlockStatusDetail}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Block/Unblock swap, as on the Remote Computers grid: offering "Block IP"
                                         for an address already blocked only prompts for elevation to rewrite a
                                         rule that is already in force. -->
                                    <DataGridTemplateColumn Header="Action" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Block IP" Style="{StaticResource MiniDangerButton}"
                                                            Command="{Binding DataContext.BlockThreatIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsSourceBlocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                    <Button Content="Unblock" Style="{StaticResource MiniGhostButton}"
                                                            Command="{Binding DataContext.UnblockThreatIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsSourceBlocked, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- PORTS -->
                    <Border Visibility="{Binding ShowPorts, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Open / listening ports on this computer" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Block Port creates an inbound Windows Firewall rule for that local port (use carefully — can break legitimate services)."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding ListeningPorts}" Style="{StaticResource ModernDataGrid}"
                                      SelectedItem="{Binding SelectedPort}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Endpoint" Binding="{Binding DisplayEndpoint}" Width="200"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Port" Binding="{Binding Port}" Width="70"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Service" Binding="{Binding ServiceHint}" Width="140"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Process" Binding="{Binding ProcessName}" Width="140"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                                    <DataGridTemplateColumn Header="Action" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Block Port" Style="{StaticResource MiniDangerButton}"
                                                        Command="{Binding DataContext.BlockSelectedPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- FIREWALL -->
                    <Grid Visibility="{Binding ShowFirewall, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Auto-block card -->
                            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="Auto-block" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,4" Margin="12,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#22101828"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="True">
                                                                <Setter Property="Background" Value="#44FF4D6D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="Bold" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="OFF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="ON"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding AutoBlockStatusText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Turn auto-block on"
                                                      IsChecked="{Binding AutoBlockEnabled}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="Minimum severity" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,8,0"/>
                                            <ComboBox Width="120"
                                                      Style="{StaticResource ModernComboBox}"
                                                      ItemsSource="{Binding AutoBlockLevelOptions}"
                                                      SelectedItem="{Binding AutoBlockMinLevel}"
                                                      IsEnabled="{Binding AutoBlockEnabled}"/>
                                        </StackPanel>
                                        <TextBlock Text="When ON, new public-IP threats at or above the minimum severity are blocked automatically (no confirmation). Private/LAN IPs, “new host” info events, and allowlisted sites (GitHub, Grok/xAI, Microsoft, …) are never auto-blocked."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="Toggle Auto-block"
                                                Command="{Binding ToggleAutoBlockCommand}"
                                                MinWidth="150" Margin="0,0,0,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Content" Value="Turn Auto-block Off"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AutoBlockEnabled}" Value="False">
                                                            <Setter Property="Content" Value="Turn Auto-block On"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Restore good sites" Style="{StaticResource GhostButton}"
                                                Command="{Binding RestoreAllowlistedCommand}" MinWidth="150" Margin="0,0,0,8"
                                                ToolTip="Remove Network Sentinel blocks on allowlisted IPs (GitHub, Grok, etc.)"/>
                                        <Button Content="Run as Admin" Style="{StaticResource GhostButton}"
                                                Command="{Binding RunAsAdminCommand}" MinWidth="150"
                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Known-good allowlist -->
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Known-good allowlist (never block)" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding AllowlistStatusText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,8" TextWrapping="Wrap"/>
                                        <TextBlock Text="Built-in list includes GitHub, xAI/Grok, Microsoft, Google, Cloudflare DNS, NuGet, and more. Domains are resolved to IPs. You can add your own, edit %LocalAppData%\NetworkSentinel\allowlist.json, or refresh the remote feed from this repo."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding AllowlistInput, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Domain (github.com) or IP address"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="Add" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding AddAllowlistEntryCommand}" Margin="0,0,6,0" MinWidth="70"/>
                                                <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                                        Command="{Binding RefreshAllowlistCommand}" Margin="0,0,6,0"/>
                                                <Button Content="Remove" Style="{StaticResource GhostButton}"
                                                        Command="{Binding RemoveAllowlistEntryCommand}" Margin="0,0,6,0"/>
                                                <Button Content="Open folder" Style="{StaticResource GhostButton}"
                                                        Command="{Binding OpenAllowlistFolderCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding AllowlistEntries}" Style="{StaticResource ModernDataGrid}"
                                              SelectedItem="{Binding SelectedAllowlistEntry}"
                                              MaxHeight="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Kind" Binding="{Binding Kind}" Width="90"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Value" Binding="{Binding Value}" Width="220"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Detail" Binding="{Binding Detail}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- IP block card -->
                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Block remote IP" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding FirewallStatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                    <TextBlock Text="IP address" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding ManualBlockIp, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="e.g. 203.0.113.50"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox Content="Inbound" IsChecked="{Binding BlockInbound}" Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox Content="Outbound" IsChecked="{Binding BlockOutbound}" Style="{StaticResource ModernCheckBox}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Block IP" Style="{StaticResource DangerButton}"
                                                Command="{Binding BlockManualIpCommand}" Margin="0,0,8,0" MinWidth="110"/>
                                        <Button Content="Unblock IP" Style="{StaticResource GhostButton}"
                                                Command="{Binding UnblockManualIpCommand}" Margin="0,0,8,0" MinWidth="110"/>
                                        <Button Content="Run as Admin" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding RunAsAdminCommand}" MinWidth="120"
                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Port block card -->
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Block local port" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Creates a Windows Defender Firewall rule for a local TCP/UDP port on this PC."
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Port" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding ManualBlockPort, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="e.g. 3389"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Protocol" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                            <ComboBox Style="{StaticResource ModernComboBox}"
                                                      ItemsSource="{Binding ProtocolOptions}"
                                                      SelectedItem="{Binding ManualBlockProtocol}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Block Port" Style="{StaticResource DangerButton}"
                                                Command="{Binding BlockManualPortCommand}" Margin="0,0,8,0" MinWidth="110"/>
                                        <Button Content="Refresh Rules" Style="{StaticResource GhostButton}"
                                                Command="{Binding RefreshFirewallRulesCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Remove All" Style="{StaticResource GhostButton}"
                                                Command="{Binding RemoveAllManagedRulesCommand}" MinWidth="110"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FirewallMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource AccentCyanBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Network Sentinel firewall rules" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Only rules created by this app (name prefix NetworkSentinel-*) are listed. Removing a rule restores traffic for that target."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove Selected" Style="{StaticResource DangerButton}"
                                            Command="{Binding RemoveSelectedRuleCommand}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding FirewallRules}" Style="{StaticResource ModernDataGrid}"
                                          SelectedItem="{Binding SelectedFirewallRule}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Kind" Binding="{Binding KindText}" Width="90"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Action" Binding="{Binding ActionText}" Width="70"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Direction" Binding="{Binding DirectionText}" Width="90"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Target" Binding="{Binding TargetText}" Width="160"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Enabled" Binding="{Binding EnabledText}" Width="70"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextElement}" Header="Rule name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTemplateColumn Header="" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remove" Style="{StaticResource MiniGhostButton}"
                                                            Command="{Binding DataContext.RemoveSelectedRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- FIREWALL CONFIG — add/edit/delete inbound and outbound rules, laid out
                         like the Linode Cloud Manager firewall page (and FireWallConfig on
                         Ubuntu): one list per direction, one form for both add and edit. -->
                    <ScrollViewer Visibility="{Binding ShowFirewallConfig, Converter={StaticResource BoolToVis}}"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Firewall configuration" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding FirewallConfigSummary}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FirewallConfigListenerText}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FirewallConfigPolicyText}" Margin="0,6,16,0" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FirewallConfigMessage}" Margin="0,6,0,0" FontSize="12"
                                               Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <Button Content="Add an Inbound Rule" Style="{StaticResource PrimaryButton}"
                                            MinWidth="180" Margin="0,0,0,8"
                                            Command="{Binding AddInboundRuleCommand}"/>
                                    <Button Content="Add an Outbound Rule" Style="{StaticResource GhostButton}"
                                            MinWidth="180" Margin="0,0,0,8"
                                            Command="{Binding AddOutboundRuleCommand}"/>
                                    <Button Content="Rescan the host firewall" Style="{StaticResource GhostButton}"
                                            MinWidth="180"
                                            ToolTip="Re-reads Windows Defender Firewall and the listening sockets"
                                            Command="{Binding RefreshFirewallConfigCommand}"/>
                                    <TextBlock Text="Scanning…" FontSize="11" Margin="0,6,0,0"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               Visibility="{Binding IsFirewallConfigScanning, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Add/edit form. Inline rather than a modal: the rule lists stay
                             visible while a rule is written, which is how you check you are not
                             duplicating one. -->
                        <Border x:Name="RuleEditorCard" Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,12"
                                Visibility="{Binding IsRuleEditorOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding RuleEditorTitle}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding RuleEditorNote}" FontSize="11.5" Margin="0,4,0,10"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Preset" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding RulePresetOptions}"
                                                  SelectedItem="{Binding RulePreset}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Action" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding RuleActionOptions}"
                                                  SelectedItem="{Binding RuleAction}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Direction" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding RuleDirectionOptions}"
                                                  SelectedItem="{Binding RuleDirection}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Label" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                                         Text="{Binding RuleLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="block-inbound-rdp   (optional — named from the port if left empty)"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Protocol" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding RuleProtocolOptions}"
                                                  SelectedItem="{Binding RuleProtocol}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Port range" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding RulePortRange, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="3389   or  8000-8001   or  80, 443   (empty = every port)"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding RuleAddressLabel}" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                                         Text="{Binding RuleAddresses, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="All IPv4, All IPv6   or  10.0.0.0/8   or  203.0.113.5"/>

                                <TextBlock Text="{Binding RuleEditorError}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Foreground="{StaticResource DangerBrush}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="110"
                                            Margin="0,0,8,0" Command="{Binding CancelRuleEditorCommand}"/>
                                    <Button Content="{Binding RuleEditorSaveText}" Style="{StaticResource PrimaryButton}"
                                            MinWidth="130" Command="{Binding SaveConfigRuleCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- MinHeight, not a fixed height: the lists share whatever the window
                             leaves them, but never shrink to a single row when the editor is open. -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" MinHeight="230">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Inbound rules" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding InboundCountText}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Add an Inbound Rule"
                                                Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                                Command="{Binding AddInboundRuleCommand}"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding InboundRules}" SelectedItem="{Binding SelectedInboundRule}"
                                              Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <!-- Label and the address list share the slack: a rule name and an
                                                 IPv6 range are both long, and fixing either at 180px cut them in
                                                 half. ElementStyle gives every cell the ellipsis-and-tooltip
                                                 treatment, so a value too wide for its column is still readable. -->
                                            <DataGridTextColumn Header="Label" Binding="{Binding LabelText}" Width="*" MinWidth="220"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="80"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="90"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Port range" Binding="{Binding PortRangeText}" Width="120"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Sources" Binding="{Binding AddressListText}" Width="*" MinWidth="200"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Created by" Binding="{Binding OriginText}" Width="150"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Profiles" Binding="{Binding ProfileScopeText}" Width="110"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Copies" Binding="{Binding CopiesText}" Width="60"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <!-- Auto, not a pinned width: Edit and Delete are shown together here
                                                 (unlike the Block/Unblock pairs elsewhere, which swap), and two
                                                 MinWidth=72 buttons plus their 4px gap need 148px inside a cell
                                                 whose 8px padding each side leaves 134 of a 150px column — so
                                                 Delete was clipped by 14px. Sizing to the content cannot drift
                                                 out again when a label or a button style changes. -->
                                            <DataGridTemplateColumn Header="" Width="Auto" MinWidth="164">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Edit" Style="{StaticResource MiniGhostButton}"
                                                                    Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.EditConfigRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Delete" Style="{StaticResource MiniDangerButton}"
                                                                    Command="{Binding DataContext.DeleteConfigRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Grid.Row="1" MinHeight="230" Margin="0,0,0,12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Outbound rules" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding OutboundCountText}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Add an Outbound Rule"
                                                Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                                Command="{Binding AddOutboundRuleCommand}"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding OutboundRules}" SelectedItem="{Binding SelectedOutboundRule}"
                                              Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Label" Binding="{Binding LabelText}" Width="*" MinWidth="220"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="80"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="90"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Port range" Binding="{Binding PortRangeText}" Width="120"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Destinations" Binding="{Binding AddressListText}" Width="*" MinWidth="200"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Created by" Binding="{Binding OriginText}" Width="150"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Profiles" Binding="{Binding ProfileScopeText}" Width="110"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Copies" Binding="{Binding CopiesText}" Width="60"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <!-- Auto, not a pinned width: Edit and Delete are shown together here
                                                 (unlike the Block/Unblock pairs elsewhere, which swap), and two
                                                 MinWidth=72 buttons plus their 4px gap need 148px inside a cell
                                                 whose 8px padding each side leaves 134 of a 150px column — so
                                                 Delete was clipped by 14px. Sizing to the content cannot drift
                                                 out again when a label or a button style changes. -->
                                            <DataGridTemplateColumn Header="" Width="Auto" MinWidth="164">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Edit" Style="{StaticResource MiniGhostButton}"
                                                                    Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.EditConfigRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Delete" Style="{StaticResource MiniDangerButton}"
                                                                    Command="{Binding DataContext.DeleteConfigRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- What is listening, and what the rules above do to it. A rule list on
                                 its own does not answer "is this port actually reachable" — the two
                                 together do, which is the pairing FireWallConfig shows. -->
                            <Border Style="{StaticResource Card}" Grid.Row="2" MinHeight="200">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Listening services" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding FirewallConfigListenerText}" FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding FirewallConfigListenerHint}" FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding ListeningServices}"
                                              Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                              MaxHeight="420">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*" MinWidth="160"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="150"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Bind address" Binding="{Binding Address}" Width="*" MinWidth="170"
                                                                ElementStyle="{StaticResource DataGridTextElementWide}"/>
                                            <DataGridTextColumn Header="Firewall" Binding="{Binding Covered}" Width="120"
                                                                ElementStyle="{StaticResource DataGridTextElement}"/>
                                            <DataGridTemplateColumn Header="" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="New rule" Style="{StaticResource MiniGhostButton}"
                                                                Command="{Binding DataContext.NewRuleForListenerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>

                    <!-- SETTINGS — mirrors the web console's Settings tab so both front-ends
                         drive the same keys in settings.json. Auto-block lives in the sidebar
                         and the Firewall view, so it is not duplicated here. -->
                    <Grid Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Monitoring" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="What the monitor watches, and how often it samples."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,14" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Live monitoring" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Watch connections, listening ports, and threats in real time."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center" MinWidth="110" Padding="12,8"
                                                    Content="{Binding Stats.IsMonitoring, Converter={StaticResource MonitorText}}"
                                                    Command="{Binding ToggleMonitoringCommand}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Monitor poll interval" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="How often the monitor samples the network stack. This is also the activity chart's sample rate, so a slower interval widens the window the chart covers."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="205" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernComboBox}"
                                                      ItemsSource="{Binding MonitorPollOptions}"
                                                      SelectedItem="{Binding SelectedMonitorPoll}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Geo lookups" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Resolve country and city for remote IPs (ipwho.is, ipapi.co fallback — both over HTTPS). Reverse DNS still runs when this is off."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding GeoLookupEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Traffic metering" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Sample the adapter byte counters for the dashboard's data-flow charts and the monthly in/out history. Physical adapters only, so VPN, Hyper-V and teaming traffic is counted once."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TrafficStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding TrafficMeterEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Failed-logon monitoring" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Watch the Windows Security event log (4625 / 4771) for failed RDP, SMB, and WinRM logons and alert on brute-force bursts. Needs Administrator, or membership in “Event Log Readers”."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AuthLogStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding AuthLogMonitorEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Closed-port scan detection" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Turn on Windows Firewall dropped-packet logging (needs Administrator) and watch that log — catches scans of closed ports that never appear as connections."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ProbeLogStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ProbeLogEnabled}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Critical threat alerts" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Send a desktop notification when a Critical-level threat is detected, so you are warned even while this window is minimized."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CriticalAlertStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding CriticalAlertsEnabled}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Intrusion detection" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Extra detectors beyond the connection heuristics."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,14" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Threat-intel blocklists" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Check remote IPs against FireHOL level1 and Spamhaus DROP. A match is an instant Critical alert — those ranges are attack infrastructure."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ThreatIntelEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="New-listener alerts" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Alert when a new port starts listening after the baseline, or a known port changes owner process — the backdoor / implant signature."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding NewListenerAlertsEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Process reputation" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Flag unsigned binaries running from Windows or Program Files, processes whose image has been deleted from disk, executables running from temp/download folders, and command shells or script hosts with outbound connections (reverse-shell signature)."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ProcessReputationEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="ARP / gateway watch" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Watch the ARP table for the default gateway's MAC address changing — the standard LAN man-in-the-middle opener."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ArpWatchStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ArpWatchEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Startup-item watch" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Watch the Startup folders, Scheduled Tasks, and the Run / RunOnce / Winlogon registry keys for new or modified startup items — the standard way malware persists across reboots."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding PersistenceWatchStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding PersistenceWatchEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Exfiltration monitor" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Sample per-connection byte counts (TCP ESTATS) and alert when outbound traffic to one non-allowlisted public host exceeds the threshold (MB per 10 minutes). Enabling the counters needs administrator rights."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ExfilStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="70" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding ExfilThresholdMbText, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ExfilMonitorEnabled}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Honeypot decoy ports" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Listen on decoy TCP ports nothing legitimate uses. Any completed connection is a zero-false-positive Critical alert. Ports already in use are skipped."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding HoneypotStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="130" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding HoneypotPortsText, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding HoneypotEnabled}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Prevention and deep inspection" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="How fast this machine reacts, what it can see inside traffic, and what it is allowed to drop. Everything here needs administrator rights."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,14" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Auto-block dry run" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Run every auto-block gate and report what would have been dropped, without writing a firewall rule. The safe way to promote a new detection source — a fresh Suricata ruleset especially — from alerting to blocking."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding PreventionDryRun}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Kernel flow events" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Sample the moment the kernel reports a new connection instead of waiting out the poll interval, using the Microsoft-Windows-Kernel-Network ETW provider. Also the only source of UDP peer addresses, which DNS hygiene needs. Falls back to timed polling when unavailable."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FlowEventsStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding FlowEventsEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Suricata signature alerts" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Read Suricata's EVE JSON log and turn signature matches into threats, which then flow through the allowlist, geo enrichment, webhooks and auto-block like any other detection. Connection heuristics see who is talking; this is what sees what is being said. Suricata is not bundled — install it and point this at its eve.json."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SuricataStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="200" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding SuricataEvePathText, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding SuricataEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="WireGuard peers" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Watch peers via wg.exe. WireGuard uses a single unconnected UDP socket, so no VPN client ever becomes a tracked connection and none of this is otherwise visible. Alerts on a peer key that was not in the baseline, an endpoint moving country, and peer removal. The box sets the per-peer transfer alert in MB per 10 minutes (0 = off, because a VPN user streaming video legitimately moves gigabytes)."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding WireGuardStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="70" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding WireGuardPeerMbText, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding WireGuardMonitorEnabled}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="DNS hygiene" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Watch how names get resolved: plaintext queries leaving the machine, encrypted DNS silently falling back to plaintext, queries to resolvers you did not approve, and allowlisted domains resolving into unfamiliar networks — the shape of a poisoning attack aimed at the never-block list. Needs kernel flow events. List your resolver IPs in the box; without them DoH on 443 is indistinguishable from ordinary web traffic."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DnsHygieneStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="200" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding DnsApprovedResolversText, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding DnsHygieneEnabled}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Remote access (web console)" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Reach the browser console from outside this machine over HTTPS. These settings configure the headless web console (--web); this app saves them and keeps the DuckDNS hostname current."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RemoteAccessStatus}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,14" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="DuckDNS subdomain" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Free hostname that follows your public IP. Enter just the label — &quot;myhost&quot; for myhost.duckdns.org. The checkbox turns the every-5-minute refresh on."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="180" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding DuckDnsDomain, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding DuckDnsEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="DuckDNS token" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="The token from your duckdns.org account page. Stored in its own file, readable only by Administrators and SYSTEM, separate from the other settings."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- PasswordBox, not a TextBox: WPF has no PasswordChar, and the token
                                                 rewrites this subdomain's DNS. Synced to the view model in code-behind
                                                 because PasswordBox.Password is deliberately not bindable. -->
                                            <PasswordBox Grid.Column="1" Width="180" VerticalAlignment="Center" Margin="0,0,12,0"
                                                         x:Name="DuckDnsTokenBox" PasswordChar="●"
                                                         PasswordChanged="OnDuckDnsTokenChanged"/>
                                            <Button Grid.Column="2" Content="Update now" VerticalAlignment="Center"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding UpdateDuckDnsNowCommand}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Serve the console over HTTPS" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Adds a TLS port alongside the plain-HTTP one. Needs the certificate below. Takes effect the next time the web console starts."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding HttpsPortText, UpdateSourceTrigger=LostFocus}"/>
                                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding HttpsEnabled}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Issue certificate" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Get a free trusted Let's Encrypt certificate for your duckdns.org name. Proves control through the DuckDNS token above, so nothing needs to be reachable on port 80. Takes a few minutes waiting on DNS, then fills in the two paths below. Renewals run from a scheduled task."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="First run only: installs the Posh-ACME module and registers a Let's Encrypt account with the email beside it."
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="200" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding AcmeEmail, UpdateSourceTrigger=LostFocus}"/>
                                            <Button Grid.Column="2" VerticalAlignment="Center" MinWidth="130"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Content="{Binding IsIssuingCertificate, Converter={StaticResource IssueCertText}}"
                                                    Command="{Binding IssueCertificateCommand}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Certificate (PEM fullchain or .pfx)" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Filled in by Issue certificate; edit it if your certificate lives somewhere else."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="280" VerticalAlignment="Center"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding TlsCertPath, UpdateSourceTrigger=LostFocus}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Private key (PEM)" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Leave empty when the certificate is a .pfx bundle."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="280" VerticalAlignment="Center"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding TlsKeyPath, UpdateSourceTrigger=LostFocus}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Redirect HTTP to HTTPS" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Requests that arrive by hostname get sent to the TLS port. Requests to a bare IP stay on HTTP, because the certificate only covers the name."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding HttpsRedirect}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="HTTPS only (turn off plain HTTP)" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Skip the plain-HTTP listener entirely, so the master password can only cross the wire encrypted. Needs HTTPS on with a working certificate — if the certificate fails to load at startup, plain HTTP stays on so the console isn't locked out. Takes effect the next time the web console starts."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding HttpsOnly}"/>
                                        </Grid>

                                        <TextBlock Text="Reaching this from outside your network means anyone who guesses the master password can change this machine's firewall. A VPN or Tailscale is safer than forwarding a port; if you do forward one, forward only the HTTPS port."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Alerting &amp; auto-block" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Get alerts off this machine, and stop block rules from piling up forever."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,14" TextWrapping="Wrap"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Webhook alerts" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="POST Critical threats to a webhook URL — ntfy, Slack, and Discord formats are detected automatically; anything else receives generic JSON. Leave empty to disable."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding WebhookStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Width="280" VerticalAlignment="Center"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding WebhookUrl, UpdateSourceTrigger=LostFocus}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Auto-block expiry" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Automatically remove auto-created block rules after this long. The address stops counting as blocked right away; the firewall rule itself is deleted by a background sweep, which needs the app to be running elevated. Manual blocks are always permanent."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="205" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernComboBox}"
                                                      ItemsSource="{Binding AutoBlockExpiryOptions}"
                                                      SelectedItem="{Binding SelectedAutoBlockExpiry}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Allowlist" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Known-good hosts that are never blocked."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,14" TextWrapping="Wrap"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Remote allowlist feed" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="Refresh the known-good domain/IP list from the online feed. Off uses only the local and built-in lists."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AllowlistStatusText}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding AllowlistUseRemoteFeed}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Data" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="Settings, allowlist, and the web console's master-password hash live in the shared program data folder. This app, the TUI, and the web console all read the same files."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DataDirectoryText}" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"
                                Visibility="{Binding SettingsMessage, Converter={StaticResource NotEmptyVis}}">
                            <TextBlock Text="{Binding SettingsMessage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource AccentCyanBrush}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
