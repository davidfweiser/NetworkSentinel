<Application x:Class="NetworkSentinel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NetworkSentinel.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:ThreatLevelToBrushConverter x:Key="ThreatBrush"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:MonitoringToTextConverter x:Key="MonitorText"/>
            <conv:NavSelectedConverter x:Key="NavSelected"/>
            <conv:InvertBoolConverter x:Key="InvertBool"/>

            <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
