<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native/FlowEvents.cs consumes ETW records through raw EVENT_RECORD pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>NetworkSentinel.Program</StartupObject>
    <AssemblyName>NetworkSentinel</AssemblyName>
    <RootNamespace>NetworkSentinel</RootNamespace>
    <Product>Network Sentinel</Product>
    <Description>Native Windows network port monitor with GUI, TUI, and headless web UI</Description>
    <Version>0.5.1</Version>
    <Company>Network Sentinel</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel backs the headless web console (-w). HttpListener can serve TLS on Windows,
         but only against a certificate imported into the machine store and bound to the port
         with `netsh http add sslcert` — per-port, admin-only, and re-done at every renewal.
         Kestrel reads the PEM/.pfx straight off disk, which is what ACME renewal produces. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <!-- EventLogWatcher (Security channel 4625) for failed-logon burst detection. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\allowlist-default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Data\allowlist-default.json" />
    <!-- Deployed as a loose file so toast notifications can reference it as their icon. -->
    <None Update="Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

