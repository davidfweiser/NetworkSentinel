<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>NetworkSentinel.Program</StartupObject>
    <AssemblyName>NetworkSentinel</AssemblyName>
    <RootNamespace>NetworkSentinel</RootNamespace>
    <Product>Network Sentinel</Product>
    <Description>Native Windows network port monitor with GUI, TUI, and headless web UI</Description>
    <Version>0.2.2</Version>
    <Company>Network Sentinel</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\allowlist-default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Data\allowlist-default.json" />
  </ItemGroup>

</Project>
